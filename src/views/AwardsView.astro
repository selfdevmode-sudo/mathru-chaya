---
import { getCollection } from 'astro:content';
import type { Lang } from '../../site.config';
import { t } from '../lib/i18n';
import AwardCard from '../components/AwardCard.astro';

const { lang } = Astro.props as { lang: Lang };

// Newest first, same NaN-safe sort as HomeView/ProjectsView. If there are zero
// awards the page still renders (it's always in the nav) — just the heading,
// no fake placeholder content (ADR-0007).
const awards = (await getCollection('awards'))
  .slice()
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---
<section class="section wrap">
  <h1>{t(lang, 'nav_awards')}</h1>

  {awards.length > 0 && (
    <div class="grid-cards">
      {awards.map((award) => <AwardCard award={award} lang={lang} />)}
    </div>
  )}
</section>

<style>
  h1 { margin-bottom: 1rem; }
</style>
