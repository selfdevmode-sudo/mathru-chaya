---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AboutView from '../../../views/AboutView.astro';
import { site, type Lang } from '../../../../site.config';
import { nonDefaultLangs } from '../../../lib/routes';
import { t } from '../../../lib/i18n';
export const getStaticPaths = nonDefaultLangs;
const lang = Astro.params.lang as Lang;
---
<BaseLayout {lang} title={`${t(lang, 'nav_about')} · ${site.name}`} description={site.tagline} path="/about/">
  <AboutView {lang} />
</BaseLayout>
