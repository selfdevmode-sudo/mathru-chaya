---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AwardsView from '../../../views/AwardsView.astro';
import { site, type Lang } from '../../../../site.config';
import { nonDefaultLangs } from '../../../lib/routes';
import { t } from '../../../lib/i18n';
export const getStaticPaths = nonDefaultLangs;
const lang = Astro.params.lang as Lang;
---
<BaseLayout {lang} title={`${t(lang, 'nav_awards')} · ${site.name}`} description={site.tagline} path="/awards/">
  <AwardsView {lang} />
</BaseLayout>
