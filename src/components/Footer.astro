---
import { site } from '../../site.config';
import { t } from '../lib/i18n';
import type { Lang } from '../../site.config';
const { lang } = Astro.props as { lang: Lang };
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <p class="name">{site.name}</p>
    <p class="region">{site.region}</p>
    <p><a href={`tel:${site.phone}`}>{site.phone}</a></p>
    <p class="rights">&copy; {year} {site.name}. {t(lang, 'footer_rights')}</p>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--c-border); background: var(--c-bg-alt); padding-block: 1.5rem; margin-top: 2rem; }
  footer .wrap { display: flex; flex-direction: column; gap: .3rem; text-align: center; color: var(--c-text-soft); font-size: .85rem; }
  footer a { color: var(--c-text-soft); }
  .name { font-family: var(--font-head); color: var(--c-accent); font-weight: bold; font-size: 1rem; }
  @media (min-width: 48rem) {
    footer .wrap { text-align: left; }
  }
</style>
