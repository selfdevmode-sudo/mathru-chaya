---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { site } from '../../site.config';
const { title, description, image } = Astro.props as {
  title: string;
  description?: string;
  image?: string;
};
const canonical = Astro.url.href;

// Default og:image when the caller doesn't pass one explicitly: the first
// `featured: true` project's cover photo, falling back to the newest project
// (same featured-else-newest rule as HomeView's featured section). Emits no
// og:image at all when there are zero projects or the chosen project has no
// photo — never a broken/empty tag (ADR-0007 plug-n-play).
async function defaultOgImage(): Promise<string | undefined> {
  const projects = await getCollection('projects');
  if (projects.length === 0) return undefined;
  const featured = projects.filter((p) => p.data.featured);
  const byNewest = (a: (typeof projects)[number], b: (typeof projects)[number]) =>
    (b.data.year ?? 0) - (a.data.year ?? 0);
  const cover = (featured.length > 0 ? featured : projects.slice().sort(byNewest))[0]?.data.photos[0];
  if (!cover) return undefined;
  const optimized = await getImage({ src: cover });
  return optimized.src;
}

const ogImage = image ?? (await defaultOgImage());
const ogImageUrl = ogImage ? new URL(ogImage, site.url).toString() : undefined;
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
