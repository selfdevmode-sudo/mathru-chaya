---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../../site.config';
import { t } from '../lib/i18n';

type Facts = NonNullable<CollectionEntry<'projects'>['data']['facts']>;
const { facts, lang } = Astro.props as { facts: Facts; lang: Lang };
---
<div class="facts">
  {facts.duration && <div><b class="label">{t(lang, 'detail_duration')}</b>{facts.duration}</div>}
  {facts.teamSize && <div><b class="label">{t(lang, 'detail_team')}</b>{facts.teamSize}</div>}
  {facts.ledBy && <div><b class="label">{t(lang, 'detail_led_by')}</b>{facts.ledBy}</div>}
  {facts.status && <div><b class="label">{t(lang, 'detail_status')}</b>{facts.status}</div>}
</div>
<style>
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem 1.5rem; }
  .facts .label { display: block; margin-bottom: .2rem; }
  /* Single column on very small phones (~320-360px) so longer values (e.g. a
     builder's full name) never feel squeezed against the facts grid's gutter. */
  @media (max-width: 26rem) {
    .facts { grid-template-columns: 1fr; gap: .9rem; }
  }
</style>
