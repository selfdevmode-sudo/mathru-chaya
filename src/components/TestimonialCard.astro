---
import type { CollectionEntry } from 'astro:content';
import { pickText } from '../lib/i18n';
import type { Lang } from '../../site.config';
const { testimonial, lang } = Astro.props as { testimonial: CollectionEntry<'testimonials'>; lang: Lang };
const d = testimonial.data;
const quote = pickText(lang, d, 'quote') ?? d.quote_en;
const meta = [d.role, d.place].filter(Boolean).join(', ');
---
<figure class="testimonial">
  <blockquote>&ldquo;{quote}&rdquo;</blockquote>
  <figcaption>
    <span class="name">{d.name}</span>
    {meta && <span class="meta"> — {meta}</span>}
  </figcaption>
</figure>
<style>
  .testimonial { background: var(--c-bg-alt); border: 1px solid var(--c-border); border-radius: 6px; padding: 1.2rem; }
  blockquote { margin: 0 0 .6rem; font-style: italic; }
  figcaption { color: var(--c-text-soft); font-size: .85rem; }
  .name { font-weight: bold; }
</style>
