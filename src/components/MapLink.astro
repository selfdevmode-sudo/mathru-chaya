---
import type { Lang } from '../../site.config';
import { t } from '../lib/i18n';

const { href, lang } = Astro.props as { href: string; lang: Lang };
---
<a class="map-link" href={href} target="_blank" rel="noopener">📍 {t(lang, 'detail_open_map')}</a>
<style>
  .map-link {
    display: block; padding: .8rem 1.1rem; border-radius: var(--radius);
    background: var(--c-bg-alt); border: 1px solid var(--c-border);
    color: var(--c-text); text-decoration: none;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .map-link:hover, .map-link:focus-visible { border-color: var(--c-accent); background: var(--c-bg); }
</style>
