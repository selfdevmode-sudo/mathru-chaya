---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../../site.config';
import { t, pickText } from '../lib/i18n';

const { award, lang } = Astro.props as { award: CollectionEntry<'awards'>; lang: Lang };
const d = award.data;
const givenByLine = d.givenBy ? `${t(lang, 'awards_given_by')}: ${d.givenBy}` : undefined;
const note = pickText(lang, d, 'note');
---
<article class="award">
  {d.photo
    ? <Image src={d.photo} alt={d.title} widths={[400, 800]} sizes="(max-width: 48rem) 100vw, 20rem" />
    : <div class="medallion" aria-hidden="true">🏆</div>}
  <h3>{d.title}</h3>
  {givenByLine && <p class="label">{givenByLine}</p>}
  {d.year && <p class="year">{d.year}</p>}
  {note && <p class="note">{note}</p>}
</article>
<style>
  .award img { border-radius: var(--radius); aspect-ratio: 4/3; object-fit: cover; }
  .medallion {
    aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center;
    font-size: 2.5rem; border: 1px solid var(--c-gold); border-radius: var(--radius); background: var(--c-bg-alt);
  }
  .award h3 { margin-top: .6rem; font-size: 1.05rem; }
  .award .year { color: var(--c-text-soft); font-size: .85rem; margin-top: .1rem; }
  .award .note { margin-top: .4rem; font-size: .9rem; }
</style>
