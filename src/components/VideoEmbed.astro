---
import type { Lang } from '../../site.config';
import { t } from '../lib/i18n';

const { href, lang } = Astro.props as { href: string; lang: Lang };
---
<div class="video-embed">
  <a class="video-link" href={href} target="_blank" rel="noopener" data-video-href={href}>▶ {t(lang, 'detail_video')}</a>
</div>
<script>
  // Progressive enhancement only: the server-rendered markup is always a
  // plain working link to the video (no JS needed, opens in a new tab).
  // If — and only if — the href genuinely parses as a YouTube URL do we
  // swap it for a lazy-loaded embedded player on click. Any parse failure
  // or non-YouTube host leaves the original link untouched: the failure
  // mode is "still a working link", never a broken embed.
  function youtubeId(href: string): string | null {
    let url: URL;
    try {
      url = new URL(href);
    } catch {
      return null;
    }
    // Strip a leading www./m. subdomain so mobile and desktop links match alike.
    const host = url.hostname.replace(/^(www\.|m\.)/, '');
    // Short-link form: youtu.be/<id>
    if (host === 'youtu.be') {
      const id = url.pathname.slice(1).split('/')[0];
      return id || null;
    }
    // Full-site forms on youtube.com / youtube-nocookie.com
    if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
      if (url.pathname === '/watch') {
        return url.searchParams.get('v');
      }
      // Path forms: /embed/<id> and /shorts/<id>
      const m = url.pathname.match(/^\/(?:embed|shorts)\/([^/]+)/);
      if (m) return m[1];
    }
    return null; // unknown host/path — fall through to the plain working link
  }

  document.querySelectorAll<HTMLAnchorElement>('.video-link').forEach((link) => {
    const href = link.dataset.videoHref;
    if (!href) return;
    const id = youtubeId(href);
    if (!id) return; // not YouTube — leave the working link as-is
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.loading = 'lazy';
      iframe.allow = 'accelerate; autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = link.textContent?.trim() || 'video';
      iframe.className = 'video-frame';
      link.replaceWith(iframe);
    });
  });
</script>
<style>
  .video-link {
    display: inline-block; padding: .6rem 1.2rem; border-radius: 6px;
    background: var(--c-bg-alt); border: 1px solid var(--c-border);
    color: var(--c-text); text-decoration: none;
  }
  .video-embed :global(.video-frame) {
    width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 6px; display: block;
  }
</style>
